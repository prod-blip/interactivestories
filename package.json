{
  "name": "moonlit-stories",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@moonlit/web",
    "dev:game": "npm run dev --workspace=@moonlit/mouse-and-lion",
    "dev:crow-and-pitcher": "npm run dev --workspace=@moonlit/crow-and-pitcher",
    "dev:tortoise-and-rabbit": "npm run dev --workspace=@moonlit/tortoise-and-rabbit",
    "dev:tortoise-and-tiger": "npm run dev --workspace=@moonlit/tortoise-and-tiger",
    "build:games": "npm run build --workspace=@moonlit/mouse-and-lion && npm run build --workspace=@moonlit/crow-and-pitcher && npm run build --workspace=@moonlit/tortoise-and-rabbit && npm run build --workspace=@moonlit/tortoise-and-tiger",
    "build:web": "npm run build --workspace=@moonlit/web",
    "build": "npm run build:games && npm run build:web",
    "android:sync": "npm run sync --workspace=@moonlit/mobile",
    "android:open": "npm run open --workspace=@moonlit/mobile",
    "android:debug": "npm run build:debug --workspace=@moonlit/mobile",
    "android:bundle": "npm run build:bundle --workspace=@moonlit/mobile",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "nanoid": "^3.3.18",
    "typescript": "~6.0.2"
  }
}
